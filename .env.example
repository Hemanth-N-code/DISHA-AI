# DISHA AI Environment Configuration
# Copy this file to .env or backend/.env

# Application Mode
DEBUG=True
APP_NAME=DISHA AI

# Database Configuration
# Defaults to SQLite (disha.db) if PostgreSQL is unavailable
DATABASE_URL=postgresql://disha:dishapassword@localhost:5432/disha_db
# For SQLite local file:
# DATABASE_URL=sqlite:///./disha.db

# Security
SECRET_KEY=disha-ai-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers: "offline", "openai", "gemini", or "anthropic"
# "offline" works 100% locally with deterministic synthesis and TF-IDF RAG without external API keys
LLM_PROVIDER=offline

# Optional External API Keys (Leave blank to use robust offline mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Recommendation Framework Weights (Sum = 1.0)
WEIGHT_INTEREST=0.30
WEIGHT_ACADEMIC=0.25
WEIGHT_SKILL=0.20
WEIGHT_PREFERENCE=0.15
WEIGHT_GOAL=0.10

# Career Diversity Index Parameters
LAMBDA_DIVERSITY=0.35
MAX_CAREER_HORIZON_LIMIT=16
